# Svype frontend env — copy this file to `.env` and fill in your own values.
# This file IS committed to git. The real `.env` is gitignored.

# URL the Expo client uses to reach the Django backend.
# Use your own ngrok tunnel so it works from any wifi network.
# Format: https://<your-subdomain>.ngrok-free.dev/api
EXPO_PUBLIC_API_BASE_URL=https://your-reserved-subdomain.ngrok-free.dev/api
